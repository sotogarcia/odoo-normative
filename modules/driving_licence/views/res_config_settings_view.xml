<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="0">

  <!-- Settings view: manage driving licence categories -->
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.driving.licence</field>
    <field name="model">res.config.settings</field>
    <field name="type">form</field>
    <field name="mode">extension</field>
    <field name="priority" eval="20" />
    <field name="active" eval="True" />
    <field name="inherit_id" ref="base.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app
          name="driving_licence"
          string="Driving Licence"
          data-string="Driving Licence"
          groups="base.group_system"
        >
          <block
            name="driving_licence_settings_attribute_values"
            title="Driving Licences"
          >
            <setting
              id="driving_licence_catalogue"
              string="Driving Licences"
              help="Manage national driving licence categories and implied licences."
            >
              <button
                name="%(driving_licence.action_driving_licence_act_window)d"
                string="Licences"
                type="action"
                class="btn-link"
                icon="fa-car"
              />
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>

</odoo>
