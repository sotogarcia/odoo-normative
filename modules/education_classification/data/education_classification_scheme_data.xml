  <!-- SCHEME: ISCED-P

    - Classification··: International Standard Classification of Education
    - Dimension·······: Educational Programmes
    - Scope···········: International
    - Authority·······: UNESCO Institute for Statistics
  - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

  <record id="scheme_isced_p" model="education.classification.scheme">
    <field name="code">ISCED-P</field>
    <field name="name">International Standard Classification of Education - Programmes</field>
    <field name="description">International classification of educational programmes by level and programme characteristics.</field>
    <field name="dimension">p</field>
    <field name="scope">international</field>
    <field name="authority_id" ref="partner_unesco_uis" />
    <field name="active" eval="True" />
  </record>

  <!-- SCHEME: ISCED-A

