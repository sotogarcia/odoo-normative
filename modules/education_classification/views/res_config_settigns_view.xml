<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="0">

  <!-- VIEWS: "Education Classification Settings"

    - Model·········: res.config.settings
    - Inherits······: base.res_config_settings_view_form
    - View priority·: 20
    - Access········: System administrators
    - Purpose·······: Classification catalogue management
  - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

  <!-- Form view for "res.config.settings" -->
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.education.classification</field>
    <field name="model">res.config.settings</field>
    <field name="type">form</field>
    <field name="mode">extension</field>
    <field name="priority" eval="20" />
    <field name="active" eval="True" />
    <field name="inherit_id" ref="base.res_config_settings_view_form" />
    <field name="arch" type="xml">

      <xpath expr="//form" position="inside">

        <app
          name="education_classification"
          string="ISCED"
          data-string="ISCED — Education Classification"
          groups="base.group_system"
        >

          <!-- Classification catalogues -->

          <block
            name="education_classification_catalogues"
            title="Classification Catalogues"
          >

            <!-- Classification schemes -->
            <setting
              id="education_classification_scheme_setting"
              string="Classification Schemes"
              help="Manage educational classification schemes and their authorities."
            >
              <button
                name="%(education_classification.action_scheme_act_window)d"
                string="Manage schemes"
                type="action"
                class="btn-link"
                icon="fa-arrow-right"
              />
            </setting>

            <!-- Classification editions -->
            <setting
              id="education_classification_edition_setting"
              string="Classification Editions"
              help="Manage editions, versions, and their validity periods."
            >
              <button
                name="%(education_classification.action_edition_act_window)d"
                string="Manage editions"
                type="action"
                class="btn-link"
                icon="fa-arrow-right"
              />
            </setting>

            <!-- Classification items -->
            <setting
              id="education_classification_item_setting"
              string="Classification Categories"
              help="Manage hierarchical categories within classification editions."
            >
              <button
                name="%(education_classification.action_item_act_window)d"
                string="Manage categories"
                type="action"
                class="btn-link"
                icon="fa-arrow-right"
              />
            </setting>

          </block>

          <!-- Correspondence mappings -->

          <block
            name="education_classification_correspondences"
            title="Correspondence Mappings"
          >

            <!-- Classification mappings -->
            <setting
              id="education_classification_mapping_setting"
              string="Classification Mappings"
              help="Manage correspondences between classification editions."
            >
              <button
                name="%(education_classification.action_mapping_act_window)d"
                string="Manage mappings"
                type="action"
                class="btn-link"
                icon="fa-arrow-right"
              />
            </setting>

            <!-- Classification mapping rules -->
            <setting
              id="education_classification_rule_setting"
              string="Mapping Rules"
              help="Manage simple, composite, conditional, and unmatched rules."
            >
              <button
                name="%(education_classification.action_rule_act_window)d"
                string="Manage rules"
                type="action"
                class="btn-link"
                icon="fa-arrow-right"
              />
            </setting>

            <!-- Classification mapping rule lines -->
            <setting
              id="education_classification_rule_line_setting"
              string="Mapping Rule Lines"
              help="Manage the source and target categories of mapping rules."
            >
              <button
                name="%(education_classification.action_rule_line_act_window)d"
                string="Manage rule lines"
                type="action"
                class="btn-link"
                icon="fa-arrow-right"
              />
            </setting>

          </block>

        </app>

      </xpath>

    </field>
  </record>

</odoo>
