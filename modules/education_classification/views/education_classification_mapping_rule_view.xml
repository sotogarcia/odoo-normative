<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="0">

  <!-- VIEWS: "Rule"

    - Model·········: education.classification.rule
    - _rec_name·····: mapping_id (computed display_name)
    - Domain········: []
    - Context·······: {}
    - Parent menu ··: base.menu_custom
    - View priority·: 16    Sequence····: 10
    - Action help···: There are no classification rules yet
  - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

  <!-- List view for "education.classification.rule" -->
  <record id="view_education_classification_rule_list" model="ir.ui.view">
    <field name="name">view.education.classification.rule.list</field>
    <field name="model">education.classification.rule</field>
    <field name="type">list</field>
    <field name="mode">primary</field>
    <field name="priority" eval="16" />
    <field name="active" eval="True" />
    <field name="arch" type="xml">
      <list string="Classification Rules" create="1" delete="1" edit="1">
        <!-- <field name="sequence" class="oe_field_sequence" widget="handle" /> -->
        <field name="mapping_id" class="oe_field_mapping_id" />
        <field name="rule_type" class="oe_field_rule_type" />
        <field name="relation_type" class="oe_field_relation_type" />
        <field
          name="state"
          class="oe_field_state"
          widget="badge"
          decoration-warning="state == 'draft'"
          decoration-info="state == 'review'"
          decoration-success="state == 'validated'"
          decoration-danger="state == 'obsolete'"
        />
        <field name="condition_description" class="oe_field_condition_description" optional="hide" />
        <field name="notes" class="oe_field_notes" optional="hide" />
      </list>
    </field>
  </record>

  <!-- Form view for "education.classification.rule" -->
  <record id="view_education_classification_rule_form" model="ir.ui.view">
    <field name="name">view.education.classification.rule.form</field>
    <field name="model">education.classification.rule</field>
    <field name="type">form</field>
    <field name="mode">primary</field>
    <field name="priority" eval="16" />
    <field name="active" eval="True" />
    <field name="arch" type="xml">
      <form string="Classification Rule" create="1" delete="1" edit="1">
        <sheet>
          <field name="id" class="oe_field_id" invisible="1" />

          <div class="oe_button_box" name="button_box" />

          <widget
            name="web_ribbon"
            title="Obsolete"
            bg_color="bg-danger"
            invisible="state != 'obsolete'"
          />

          <div class="oe_title">
            <h1>
              <field name="display_name" class="oe_field_display_name" readonly="1" />
            </h1>
          </div>

          <group>
            <group string="Correspondence">
              <field name="mapping_id" class="oe_field_mapping_id" />
              <field name="sequence" class="oe_field_sequence" />
              <field name="rule_type" class="oe_field_rule_type" />
              <field name="relation_type" class="oe_field_relation_type" />
            </group>

            <group string="Validation">
              <field
                name="state"
                class="oe_field_state"
                widget="badge"
                decoration-warning="state == 'draft'"
                decoration-info="state == 'review'"
                decoration-success="state == 'validated'"
                decoration-danger="state == 'obsolete'"
              />
            </group>
          </group>

          <notebook>

            <page string="Categories" name="categories">
              <field name="line_ids" class="oe_field_line_ids" nolabel="1">
                <list string="Rule Categories" create="1" delete="1" edit="1" editable="bottom">
                  <!-- <field name="sequence" class="oe_field_sequence" widget="handle" /> -->
                  <field name="side" class="oe_field_side" />
                  <field name="item_id" class="oe_field_item_id" />
                </list>

                <form string="Rule Category" create="1" delete="1" edit="1">
                  <sheet>
                    <field name="id" class="oe_field_id" invisible="1" />

                    <div class="oe_button_box" name="button_box" />

                    <div class="oe_title">
                      <h1>
                        <field
                          name="display_name"
                          class="oe_field_display_name"
                          readonly="1"
                        />
                      </h1>
                    </div>

                    <group>
                      <group string="Category">
                        <field name="rule_id" class="oe_field_rule_id" readonly="1" />
                        <field name="side" class="oe_field_side" />
                        <field name="item_id" class="oe_field_item_id" />
                      </group>

                      <group string="Ordering">
                        <field name="sequence" class="oe_field_sequence" />
                      </group>
                    </group>

                  </sheet>
                </form>
              </field>
            </page>

            <page
              string="Conditions"
              name="conditions"
              invisible="rule_type != 'conditional' and not condition_description"
            >
              <field
                name="condition_description"
                class="oe_field_condition_description"
                nolabel="1"
                placeholder="Describe the conditions for applying this rule..."
              />
            </page>

            <page string="Notes" name="notes">
              <field
                name="notes"
                class="oe_field_notes"
                nolabel="1"
                placeholder="Additional observations about this rule..."
              />
            </page>

          </notebook>

        </sheet>
      </form>
    </field>
  </record>

  <!-- Search view for "education.classification.rule" -->
  <record id="view_education_classification_rule_search" model="ir.ui.view">
    <field name="name">view.education.classification.rule.search</field>
    <field name="model">education.classification.rule</field>
    <field name="type">search</field>
    <field name="mode">primary</field>
    <field name="priority" eval="16" />
    <field name="active" eval="True" />
    <field name="arch" type="xml">
      <search string="Classification Rules">
        <field name="mapping_id" class="oe_field_mapping_id" />
        <field name="rule_type" class="oe_field_rule_type" />
        <field name="relation_type" class="oe_field_relation_type" />
        <field name="condition_description" class="oe_field_condition_description" />
        <field name="notes" class="oe_field_notes" />

        <separator />

        <filter
          name="rule_simple"
          string="Simple"
          domain="[('rule_type', '=', 'simple')]"
        />
        <filter
          name="rule_composite"
          string="Composite"
          domain="[('rule_type', '=', 'composite')]"
        />
        <filter
          name="rule_conditional"
          string="Conditional"
          domain="[('rule_type', '=', 'conditional')]"
        />
        <filter
          name="rule_no_match"
          string="No Match"
          domain="[('rule_type', '=', 'no_match')]"
        />

        <separator />

        <filter
          name="relation_exact"
          string="Exact Match"
          domain="[('relation_type', '=', 'exact')]"
        />
        <filter
          name="relation_close"
          string="Close Match"
          domain="[('relation_type', '=', 'close')]"
        />
        <filter
          name="relation_broader"
          string="Broader Match"
          domain="[('relation_type', '=', 'broader')]"
        />
        <filter
          name="relation_narrower"
          string="Narrower Match"
          domain="[('relation_type', '=', 'narrower')]"
        />
        <filter
          name="relation_related"
          string="Related Match"
          domain="[('relation_type', '=', 'related')]"
        />

        <separator />

        <filter
          name="state_draft"
          string="Draft"
          domain="[('state', '=', 'draft')]"
        />
        <filter
          name="state_review"
          string="Under Review"
          domain="[('state', '=', 'review')]"
        />
        <filter
          name="state_validated"
          string="Validated"
          domain="[('state', '=', 'validated')]"
        />
        <filter
          name="state_obsolete"
          string="Obsolete"
          domain="[('state', '=', 'obsolete')]"
        />

        <group expand="1" string="Group By">
          <filter
            name="group_by_mapping_id"
            string="Mapping"
            context="{'group_by': 'mapping_id'}"
          />
          <filter
            name="group_by_rule_type"
            string="Rule Type"
            context="{'group_by': 'rule_type'}"
          />
          <filter
            name="group_by_relation_type"
            string="Relation Type"
            context="{'group_by': 'relation_type'}"
          />
          <filter
            name="group_by_state"
            string="State"
            context="{'group_by': 'state'}"
          />
        </group>
      </search>
    </field>
  </record>

  <!-- Main window action for education.classification.rule -->
  <record id="action_rule_act_window" model="ir.actions.act_window">
    <field name="type">ir.actions.act_window</field>
    <field name="name">Classification Rules</field>
    <field name="res_model">education.classification.rule</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="search_view_id" ref="view_education_classification_rule_search" />
    <field name="help" type="html">
      <p class="oe_view_nocontent_create">
        Click to add a new classification rule
      </p>
      <p>
        There are no classification rules yet.
      </p>
    </field>
  </record>

