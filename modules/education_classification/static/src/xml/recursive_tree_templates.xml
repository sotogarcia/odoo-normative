    -->

    <!-- Dedicated renderer template: no global modifications to web.ListRenderer. -->
    <t t-name="education_classification.RecursiveListRenderer"
       t-inherit="web.ListRenderer"
       t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="attributes">
            <attribute name="class" add="o_education_classification_recursive_list" separator=" "/>
        </xpath>
        <!-- The selector header can be absent (e.g. a Many2one search dialog).
             Anchor the expander column to the first header cell instead. -->
        <xpath expr="//thead/tr/th[1]" position="before">
            <th class="o_recursive_expand_column cursor-default o_list_button"/>
        </xpath>
        <xpath expr="//tfoot/tr/td[1]" position="before">
            <td class="o_recursive_expand_column"/>
        </xpath>
    </t>

    <!-- Dedicated record row: recursively render children of expanded records. -->
    <t t-name="education_classification.RecursiveListRenderer.RecordRow"
       t-inherit="web.ListRenderer.RecordRow"
       t-inherit-mode="primary">
        <xpath expr="//tr[hasclass('o_data_row')]" position="after">
            <t t-if="record.expanded &amp;&amp; record.children &amp;&amp; record.children.length">
                <t t-foreach="record.children" t-as="record" t-key="record.id">
                    <t t-call="{{ constructor.recordRowTemplate }}"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//tr[hasclass('o_data_row')]/td[1]" position="before">
            <td class="o_recursive_expand_column"
                t-att-style="'--ec-recursive-depth: ' + (record.depth || 0)">
                <t t-set="canExpand" t-value="this.hasChildren(record)"/>
                <button t-if="canExpand"
                        type="button"
                        class="o_expand_button"
                        aria-label="Expand or collapse child categories"
                        title="Expand or collapse child categories"
                        t-att-aria-expanded="record.expanded ? 'true' : 'false'"
                        t-att-aria-busy="record.loadingChildren ? 'true' : 'false'"
                        t-att-data-expand="record.resId"
                        t-att-data-depth="record.depth || 0"
                        t-att-disabled="record.loadingChildren || undefined"
                        t-on-click.stop.prevent="_onExpandClick">
                    <span aria-hidden="true"
                          t-att-class="'fa ' + (record.expanded ? 'fa-caret-down' : 'fa-caret-right')"/>
                </button>
                <span t-if="!canExpand &amp;&amp; record.depth &gt; 0"
                      class="o_recursive_bullet"
                      t-att-data-depth="record.depth"
                      aria-hidden="true"/>
            </td>
        </xpath>
    </t>
</templates>
